<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/ytGeneralBackgroundA"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:id="@+id/close_button"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            android:layout_width="@dimen/yt_sys_measurement_action_height_prominent"
            android:layout_height="@dimen/yt_sys_measurement_action_height_prominent"
            android:src="@drawable/yt_outline_experimental_x_black_24"
            android:scaleType="center"
            android:tint="?attr/ytTextPrimary"
            android:contentDescription="@string/account_switcher_close_button"
            android:layout_marginEnd="12dp"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textAppearance="@style/TextAppearance.YouTube.Headline"
            android:textSize="@dimen/large_font_size"
            android:textStyle="bold"
            android:textColor="?attr/ytTextPrimary"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/account_switcher_header_title"
            android:singleLine="true"
            android:layout_weight="1"
            android:textAlignment="viewStart"/>
    </LinearLayout>
    <ListView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/account_list"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@null"
        android:layout_weight="1"/>
    <View
        android:id="@+id/footer_separator"
        android:background="?attr/ytSeparator"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/yt_sys_measurement_size_hairline"/>
    <ListView
        android:id="@+id/account_list_footer"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/extra_footers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
