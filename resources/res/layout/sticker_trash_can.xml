<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/trash_container"
    android:paddingTop="4dp"
    android:paddingBottom="8dp"
    android:visibility="invisible"
    android:layout_width="68dp"
    android:layout_height="68dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <View
        android:layout_gravity="center"
        android:id="@+id/trash_bg"
        android:background="@drawable/reel_trash_icon_transition"
        android:layout_width="@dimen/yt_sys_measurement_size_legend"
        android:layout_height="@dimen/yt_sys_measurement_size_legend"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/trash_icon"
        android:layout_width="@dimen/yt_sys_measurement_icon_size_comfortable"
        android:layout_height="@dimen/yt_sys_measurement_icon_size_comfortable"
        android:contentDescription="@null"/>
</FrameLayout>
