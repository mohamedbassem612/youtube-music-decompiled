<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/back_to_basic_settings_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/metadataeditor_image_button_24dp_container_size"
            android:layout_height="@dimen/metadataeditor_image_button_24dp_container_size"
            android:layout_marginTop="@dimen/metadataeditor_image_button_24dp_margin"
            android:layout_marginBottom="@dimen/metadataeditor_image_button_24dp_margin"
            android:src="?attr/metadataeditor_location_back_icon"
            android:contentDescription="@string/abc_action_bar_up_description"
            android:layout_marginStart="@dimen/metadataeditor_image_button_24dp_margin"
            android:layout_marginEnd="@dimen/metadataeditor_location_search_back_icon_margin_end"/>
        <EditText
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColorHint="?attr/ytTextSecondary"
            android:id="@+id/autocomplete_text"
            android:background="@color/edit_fully_transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/geo_location_search_hint"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="textFilter"
            android:imeOptions="flagNoExtractUi"/>
        <ImageButton
            android:id="@+id/reset_autocomplete_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="@dimen/metadataeditor_image_button_24dp_container_size"
            android:layout_height="@dimen/metadataeditor_image_button_24dp_container_size"
            android:layout_margin="@dimen/metadataeditor_image_button_24dp_margin"
            android:src="?attr/metadataeditor_location_delete_icon"
            android:contentDescription="@string/abc_searchview_description_clear"/>
    </LinearLayout>
    <View
        android:background="?attr/metadataeditor_location_divider_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/yt_sys_measurement_size_hairline"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <android.support.v7.widget.RecyclerView
            android:id="@+id/autocomplete_results"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="@dimen/metadataeditor_location_search_no_results_text_size"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/autocomplete_no_results_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metadataeditor_location_search_no_results_margin_top"
            android:layout_marginStart="@dimen/metadataeditor_location_search_no_results_margin_start"
            app:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_l_default"/>
    </FrameLayout>
</LinearLayout>
