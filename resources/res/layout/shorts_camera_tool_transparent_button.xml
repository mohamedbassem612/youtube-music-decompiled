<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageButton
        android:id="@+id/editor_tool_button_icon"
        android:background="@android:color/transparent"
        android:padding="@dimen/reel_edit_toolbar_button_image_padding"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"/>
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textAppearance="?attr/ytTextAppearanceBody1b"
        android:textColor="@color/editor_tool_button_text_color"
        android:id="@+id/editor_tool_button_label"
        android:paddingTop="@dimen/reel_edit_toolbar_button_text_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
</LinearLayout>
