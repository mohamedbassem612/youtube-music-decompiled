<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/processing_indicator_dialog_internal_padding"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/processing_indicator_spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateOnly="false"
        app:indicatorColor="?attr/ytStaticWhite"
        app:indicatorSize="@dimen/processing_indicator_dialog_spinner_size"
        app:trackColor="?attr/ytOverlayButtonSecondary"/>
    <TextView
        android:textAppearance="?attr/ytTextAppearanceTitle1"
        android:textStyle="bold"
        android:textColor="?attr/ytStaticWhite"
        android:id="@+id/processing_indicator_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/processing_indicator_dialog_text_top_margin"
        style="@style/TextAppearance.YouTube.Spec.Title1"/>
    <TextView
        android:textAppearance="?attr/ytTextAppearanceBody1a"
        android:textColor="@color/yt_grey1"
        android:gravity="center_horizontal"
        android:id="@+id/processing_indicator_sub_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/processing_indicator_dialog_sub_text_top_margin"
        android:maxWidth="@dimen/processing_indicator_dialog_sub_text_max_width"
        style="@style/TextAppearance.YouTube.Spec.Body1a"/>
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textAppearance="?attr/ytTextAppearanceTitle1"
        android:textColor="?attr/ytStaticWhite"
        android:gravity="center"
        android:id="@+id/processing_indicator_cancel_button"
        android:background="@drawable/processing_indicator_cancel_highlight"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/processing_indicator_dialog_text_top_margin"
        android:minWidth="60dp"
        android:minHeight="@dimen/yt_sys_measurement_action_height_compact"
        android:text="@string/cancel"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        style="@style/TextAppearance.YouTube.Spec.Title1"/>
    <com.google.android.libraries.youtube.creation.common.ui.CreationButtonView
        android:layout_gravity="start|top"
        android:id="@+id/processing_indicator_close_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/processing_indicator_close_button_margin_top"
        android:layout_marginStart="4dp"
        app:buttonContentDescription="@string/shorts_a11y_processing_indicator_cancel_button_exit_camera"
        app:creationButtonLayout="shorts_camera"
        app:iconDrawable="@drawable/yt_outline_x_white_24"/>
</LinearLayout>
