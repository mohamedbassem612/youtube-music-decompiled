<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <HorizontalScrollView
        android:id="@+id/ai_image_edit_suggestion_chips_list_scrollview"
        android:background="?attr/ytOverlayBackgroundMedium"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="start"
            android:orientation="horizontal"
            android:id="@+id/ai_image_edit_suggestion_chips_list"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ai_image_edit_text_input_container"
        android:background="?attr/ytBrandBackgroundSolid"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp">
        <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
            android:textColor="?attr/ytTextSecondary"
            android:id="@+id/ai_image_edit_disclaimer_text"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            yt:hyperlinksClickable="true"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textColor="?attr/ytTextPrimary"
                android:textColorHint="?attr/ytTextSecondary"
                android:layout_gravity="center_vertical"
                android:id="@+id/ai_image_edit_text"
                android:background="@drawable/media_gen_editor_text_input_border"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/media_gen_editor_text_edit_hint"
                android:drawablePadding="12dp"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:drawableStart="@drawable/gs_spark_vd_theme_24"
                android:drawableTint="?attr/ytTextSecondary"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:autofillHints=""/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/ai_image_edit_text_submit_button"
                android:background="@drawable/media_gen_editor_text_input_round_button"
                android:padding="9dp"
                android:visibility="gone"
                android:layout_width="@dimen/yt_sys_measurement_size_prominent"
                android:layout_height="@dimen/yt_sys_measurement_size_prominent"
                android:src="@drawable/ic_keyboard_arrow_right_black_24dp"
                android:tint="@color/media_gen_editor_submit_tint_color"
                android:contentDescription="@string/media_gen_editor_text_submit_button"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ai_image_edit_text_input_bottom_padding"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="90dp"/>
</LinearLayout>
