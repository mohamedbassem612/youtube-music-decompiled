<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="@dimen/devicepicker_route_container_padding_top"
    android:paddingBottom="@dimen/devicepicker_route_container_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/devicepicker_route_container_min_height"
    android:paddingStart="@dimen/devicepicker_route_container_padding_start"
    android:paddingEnd="@dimen/devicepicker_route_container_padding_end">
    <ImageView
        android:id="@+id/device_picker_lnp_icon"
        android:layout_width="@dimen/devicepicker_learn_more_icon_layout_width"
        android:layout_height="@dimen/devicepicker_learn_more_icon_layout_height"
        android:layout_marginStart="@dimen/devicepicker_learn_more_icon_margin_start"
        android:layout_marginEnd="@dimen/devicepicker_learn_more_icon_margin_end"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textAppearance="?attr/ytTextAppearanceTitle2"
            android:id="@+id/device_picker_lnp_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textAppearance="?attr/ytTextAppearanceBody2a"
            android:textColor="?android:attr/textColorSecondary"
            android:id="@+id/device_picker_lnp_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"/>
    </LinearLayout>
</LinearLayout>
