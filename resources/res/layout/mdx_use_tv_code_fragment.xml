<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.textfield.TextInputLayout
            android:theme="@style/Theme.GoogleMaterial.DayNight.NoActionBar"
            android:layout_gravity="center"
            android:id="@+id/tv_code_layout"
            android:paddingTop="24dp"
            android:layout_width="@dimen/mdx_tv_code_layout_width"
            android:layout_height="wrap_content"
            android:hint="@string/mdx_pref_use_tv_code_enter_tv_code_header"
            android:labelFor="@string/mdx_pref_use_tv_code_enter_tv_code_header">
            <com.google.android.libraries.youtube.mdx.manualpairing.TvCodeEditText
                android:textSize="18sp"
                android:id="@+id/tv_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLength="@integer/mdx_updated_use_tv_code_full_code_length"
                android:inputType="number"
                style="@style/Widget.GoogleMaterial.TextInputEditText.OutlinedBox"/>
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/connect_pill_container"
            android:visibility="gone"
            android:layout_width="88dp"
            android:layout_height="@dimen/yt_sys_measurement_size_legend"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <com.google.android.libraries.youtube.common.ui.YouTubeTextView
                android:gravity="center"
                android:id="@+id/connect_pill"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/mdx_pref_accessibility_use_tv_code_link_button"/>
            <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
                android:gravity="center"
                android:id="@+id/connect_pill_modern_type"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/mdx_pref_accessibility_use_tv_code_link_button"/>
        </LinearLayout>
        <Button
            android:layout_gravity="center_horizontal"
            android:id="@+id/connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/mdx_pref_accessibility_use_tv_code_link_button"/>
        <View
            android:background="?attr/ytGeneralBackgroundC"
            android:layout_width="match_parent"
            android:layout_height="@dimen/yt_sys_measurement_size_hairline"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="14sp"
            android:textColor="?attr/ytTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/get_tv_code_title"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mdx_pref_use_tv_code_get_tv_code_title"
            yt:robotoFont="medium"
            yt:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_m_heavy"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="14sp"
            android:textColor="?attr/ytTextSecondary"
            android:gravity="center_vertical"
            android:id="@+id/get_tv_code_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mdx_pref_use_tv_code_get_tv_code_steps"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            yt:robotoFont="regular"
            yt:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_m_default"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?android:attr/listPreferredItemHeight">
            <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
                android:id="@+id/learn_more"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/yt_sys_measurement_size_legend"
                android:contentDescription="@string/mdx_pref_accessibility_use_tv_code_learn_more"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
