<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/horizontal_title_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/yt_sys_measurement_size_legend"
    android:importantForAccessibility="yes">
    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/back_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/yt_outline_arrow_left_black_24"
        android:tint="?attr/ytTextPrimary"
        android:contentDescription="@string/accessibility_back"
        android:layout_marginEnd="8dp"/>
    <com.google.android.libraries.youtube.common.ui.CircularImageView
        android:id="@+id/thumbnail"
        android:visibility="gone"
        android:layout_width="@dimen/modern_title_icon_size"
        android:layout_height="@dimen/modern_title_icon_size"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:layout_marginStart="16dp"/>
    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/no_crop_thumbnail"
        android:visibility="gone"
        android:layout_width="@dimen/modern_title_icon_size"
        android:layout_height="@dimen/modern_title_icon_size"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:layout_marginStart="16dp"/>
    <android.support.constraint.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ViewStub
            android:orientation="vertical"
            android:id="@+id/title_container"
            android:inflatedId="@+id/title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/engagement_panel_header_vertical_margin"
            android:layout_marginBottom="@dimen/engagement_panel_header_vertical_margin"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/contextual_info"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textAppearance="?attr/textAppearanceSubhead"
            android:textColor="?attr/ytTextSecondary"
            android:id="@+id/contextual_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:textAlignment="viewStart"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/modern_contextual_info"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/title_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
            android:textColor="?attr/ytTextSecondary"
            android:id="@+id/modern_contextual_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:textAlignment="viewStart"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/contextual_info"
            app:layout_constraintTop_toTopOf="parent"/>
    </android.support.constraint.ConstraintLayout>
    <include layout="@layout/icon_badge_action_button"/>
    <include layout="@layout/image_action_button"/>
    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/sort_menu_anchor"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/yt_outline_adjust_black_24"
        android:tint="?attr/ytTextPrimary"
        android:contentDescription="@string/panel_menu_filter_results"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/information_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="@dimen/yt_sys_measurement_icon_size_hero"
        android:layout_height="@dimen/yt_sys_measurement_action_height_prominent"
        android:src="@drawable/yt_outline_info_circle_black_24"
        android:scaleType="center"
        android:tint="?attr/ytTextPrimary"
        android:contentDescription="@null"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/overflow_menu_anchor"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="@dimen/yt_sys_measurement_icon_size_hero"
        android:layout_height="@dimen/yt_sys_measurement_icon_size_hero"
        android:src="@drawable/yt_outline_overflow_vertical_black_24"
        android:scaleType="center"
        android:tint="?attr/ytTextPrimary"
        android:contentDescription="@null"/>
</LinearLayout>
