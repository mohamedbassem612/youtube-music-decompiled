<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/media_gen_editor_suggestion_chip_border"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="16dp"
    android:layout_marginHorizontal="4dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ai_image_edit_suggestion_chip_image"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:layout_marginEnd="4dp"
        app:shapeAppearanceOverlay="@style/MediaGenRoundedCorners3_5dp"/>
    <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
        android:textColor="?attr/ytTextPrimary"
        android:id="@+id/ai_image_edit_suggestion_chip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"/>
</LinearLayout>
