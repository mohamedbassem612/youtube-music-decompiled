<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/creation_sound_button_container"
    android:background="@drawable/creation_music_button_background"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/sound_button_leading_icon"
        android:layout_width="@dimen/yt_sys_measurement_icon_size_comfortable"
        android:layout_height="@dimen/yt_sys_measurement_icon_size_comfortable"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_music_note_v2"
        android:contentDescription="@null"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/sound_button_loading_spinner_left"
        android:visibility="gone"
        android:layout_width="@dimen/yt_sys_measurement_size_comfortable"
        android:layout_height="@dimen/yt_sys_measurement_size_comfortable"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:indeterminate="true"
        android:layout_marginStart="12dp"
        android:indeterminateTint="?attr/ytOverlayTextPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/progressBarStyle"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/sound_button_leading_icon_anim"
        android:background="@drawable/creation_sound_button_animation_background"
        android:padding="3dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/sound_button_leading_icon"
        app:layout_constraintEnd_toEndOf="@+id/sound_button_leading_icon"
        app:layout_constraintStart_toStartOf="@+id/sound_button_leading_icon"
        app:layout_constraintTop_toTopOf="@+id/sound_button_leading_icon"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/music_sound_wave_playing"/>
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textAppearance="?attr/ytTextAppearanceBody2b"
        android:textColor="?attr/ytOverlayTextPrimary"
        android:ellipsize="marquee"
        android:id="@+id/sound_button_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="154dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/sound_button_secondary_title"
        app:layout_constraintEnd_toStartOf="@+id/sound_button_trailing_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/sound_button_leading_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="16dp"
        app:robotoFont="medium"/>
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textAppearance="?attr/ytTextAppearanceLabel"
        android:textColor="?attr/ytOverlayTextPrimary"
        android:ellipsize="marquee"
        android:id="@+id/sound_button_secondary_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="154dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sound_button_trailing_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/sound_button_leading_icon"
        app:layout_constraintTop_toBottomOf="@+id/sound_button_title"
        app:layout_goneMarginEnd="16dp"/>
    <ImageView
        android:id="@+id/sound_button_trailing_button"
        android:background="@drawable/shorts_camera_tool_button_background_default"
        android:padding="@dimen/alternative_sound_trailing_padding"
        android:visibility="gone"
        android:layout_width="@dimen/alternative_sound_trailing_icon_size"
        android:layout_height="@dimen/alternative_sound_trailing_icon_size"
        android:src="@drawable/yt_outline_arrow_flip_vd_theme_24"
        android:tint="?attr/ytOverlayTextPrimary"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/alternative_sound_trailing_horizontal_margin"
        android:layout_marginEnd="@dimen/alternative_sound_trailing_horizontal_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sound_button_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/sound_button_loading_spinner"
        android:padding="@dimen/alternative_sound_trailing_padding"
        android:visibility="gone"
        android:layout_width="@dimen/alternative_sound_trailing_icon_size"
        android:layout_height="@dimen/alternative_sound_trailing_icon_size"
        android:indeterminate="true"
        android:layout_marginStart="@dimen/alternative_sound_trailing_horizontal_margin"
        android:layout_marginEnd="@dimen/alternative_sound_trailing_horizontal_margin"
        android:indeterminateTint="?attr/ytOverlayTextPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sound_button_title"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/progressBarStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
