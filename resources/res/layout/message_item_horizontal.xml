<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/message_top_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/message_renderer_padding"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="@dimen/item_large_spacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/message_icon"
            android:layout_width="@dimen/empty_state_icon_height"
            android:layout_height="@dimen/empty_state_icon_height"
            yt:layout_constraintBottom_toBottomOf="parent"
            yt:layout_constraintStart_toStartOf="parent"
            yt:layout_constraintTop_toTopOf="parent"
            yt:tint="@color/ytm_text_color_secondary_translucent"
            yt:tintMode="src_in"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="@dimen/medium_font_size"
            android:textColor="@color/ytm_text_color_secondary_translucent"
            android:id="@+id/message_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_small_spacing"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/item_large_spacing"
            android:layout_marginEnd="@dimen/item_large_spacing"
            yt:hyperlinksClickable="true"
            yt:layout_constraintBottom_toTopOf="@+id/message_subtext"
            yt:layout_constraintEnd_toStartOf="@+id/button"
            yt:layout_constraintStart_toEndOf="@+id/message_icon"
            yt:layout_constraintTop_toTopOf="parent"
            yt:layout_goneMarginBottom="0dp"
            yt:layout_goneMarginEnd="0dp"
            yt:layout_goneMarginStart="0dp"
            yt:robotoFont="regular"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textAppearance="@style/TextAppearance.YouTubeMusic.Body1"
            android:textColor="@color/ytm_text_color_tertiary_translucent"
            android:id="@+id/message_subtext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/item_large_spacing"
            android:layout_marginEnd="@dimen/item_large_spacing"
            yt:hyperlinksClickable="true"
            yt:layout_constraintBottom_toBottomOf="parent"
            yt:layout_constraintEnd_toStartOf="@+id/button"
            yt:layout_constraintStart_toEndOf="@+id/message_icon"
            yt:layout_constraintTop_toBottomOf="@+id/message_text"
            yt:layout_goneMarginEnd="0dp"
            yt:layout_goneMarginStart="0dp"
            yt:robotoFont="regular"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeButton
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            yt:layout_constraintBottom_toBottomOf="parent"
            yt:layout_constraintEnd_toEndOf="parent"
            yt:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/message_bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/message_renderer_padding"/>
</LinearLayout>
