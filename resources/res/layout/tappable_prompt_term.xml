<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/generated_thumbnail_prompt_term_padding"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/generated_thumbnail_prompt_term_bottom_margin"
    android:layout_marginHorizontal="@dimen/generated_thumbnail_prompt_term_margin"
    android:paddingHorizontal="@dimen/generated_thumbnail_prompt_term_padding">
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textAppearance="@style/TextAppearance.YouTubeMusic.GeneratedThumbnailsPromptTerm"
        android:id="@+id/term_text"
        android:background="@drawable/dashed_underline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:typographyAppearanceToken="?attr/yt_sys_typography_typestack_headline_m_default"/>
</FrameLayout>
