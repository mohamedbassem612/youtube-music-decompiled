<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textAppearance="?attr/ytTextAppearanceBody2b"
        android:textColor="?attr/ytTextPrimaryInverse"
        android:id="@+id/stop_casting_button"
        android:background="@drawable/stop_casting_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/devicepicker_stop_casting_button_margin_top"
        android:textAlignment="center"
        android:backgroundTint="?attr/ytTextPrimary"
        android:layout_marginHorizontal="@dimen/devicepicker_stop_casting_button_margin_horizontal"/>
</LinearLayout>
