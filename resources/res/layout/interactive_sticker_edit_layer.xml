<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/interactive_sticker_edit_layer"
    android:background="?attr/ytOverlayBackgroundMedium"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/interactive_sticker_editor_bar"
        android:paddingLeft="@dimen/advanced_text_options_bar_padding"
        android:paddingTop="@dimen/advanced_text_options_bar_padding"
        android:paddingBottom="@dimen/advanced_text_options_bar_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <ImageButton
            android:id="@+id/interactive_sticker_edit_layer_back_button"
            android:background="@drawable/edit_sticker_back_button_background"
            android:visibility="gone"
            android:layout_width="@dimen/edit_sticker_back_button_size"
            android:layout_height="@dimen/edit_sticker_back_button_size"
            android:layout_marginLeft="@dimen/advanced_text_back_margin_left"
            android:src="@drawable/yt_outline_arrow_left_white_24"
            android:scaleType="center"
            android:layout_centerVertical="true"
            android:contentDescription="@string/accessibility_close_button"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/advanced_text_options_bar_font_size"
            android:textColor="?attr/ytStaticWhite"
            android:id="@+id/interactive_sticker_edit_layer_done_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/advanced_text_done_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/advanced_text_done_margin_right"
            android:text="@string/reel_advanced_text_options_done"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/sticker_view_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <FrameLayout
        android:id="@+id/button_shelf_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/theme_picker_paged"
        android:layout_centerHorizontal="true"/>
    <android.support.v7.widget.RecyclerView
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/theme_picker_paged"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sticker_theme_picker_height"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
