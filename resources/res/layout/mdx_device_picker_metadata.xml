<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/device_picker_metadata_layout_parent"
        android:paddingTop="@dimen/devicepicker_metadata_container_padding_top"
        android:paddingBottom="@dimen/devicepicker_metadata_container_padding_bottom"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/devicepicker_route_container_min_height"
        android:paddingStart="@dimen/devicepicker_title_padding_start"
        android:paddingEnd="@dimen/devicepicker_route_container_padding_end">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/device_picker_metadata_container"
            android:background="@drawable/metadata_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipToOutline="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/device_picker_metadata_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/device_picker_metadata_text_holder"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:layout_marginStart="@dimen/devicepicker_metadata_icon_margin_end">
            <com.google.android.libraries.youtube.common.ui.YouTubeTextView
                android:textAppearance="?attr/ytTextAppearanceTitle2"
                android:ellipsize="marquee"
                android:gravity="start"
                android:id="@+id/device_picker_metadata_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <com.google.android.libraries.youtube.common.ui.YouTubeTextView
                android:textAppearance="?attr/ytTextAppearanceBody1a"
                android:ellipsize="marquee"
                android:gravity="start"
                android:id="@+id/device_picker_metadata_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <com.google.android.libraries.youtube.common.ui.YouTubeTextView
                android:textAppearance="?attr/ytTextAppearanceBody1b"
                android:ellipsize="marquee"
                android:gravity="start"
                android:id="@+id/device_picker_metadata_ad_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
