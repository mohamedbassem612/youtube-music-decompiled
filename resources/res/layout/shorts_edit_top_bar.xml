<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top"
    android:id="@+id/shorts_edit_top_bar_container"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="@dimen/reel_edit_top_bar_height">
    <com.google.android.libraries.youtube.creation.common.ui.CreationButtonView
        android:id="@+id/shorts_edit_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shorts_edit_toolbar_button_top_margin"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        yt:buttonContentDescription="@string/shorts_a11y_exit_editor"
        yt:creationButtonLayout="shorts_camera"
        yt:iconDrawable="@drawable/yt_outline_arrow_left_white_24"/>
    <include
        android:id="@+id/shorts_edit_sound_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_centerHorizontal="true"
        android:importantForAccessibility="yes"
        layout="@layout/creation_sound_button"/>
    <com.google.android.libraries.youtube.creation.common.ui.CreationButtonView
        android:id="@+id/shorts_edit_volume_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shorts_edit_volume_button_layout_marginTop"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        yt:buttonContentDescription="@string/shorts_editor_volume_label"
        yt:creationButtonLayout="shorts_camera"
        yt:iconDrawable="@drawable/volume_adjust_white_24"/>
    <com.google.android.libraries.youtube.creation.common.ui.CreationButtonView
        android:id="@+id/shorts_edit_outline_volume_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shorts_edit_volume_button_layout_marginTop"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        yt:buttonContentDescription="@string/shorts_editor_volume_label"
        yt:creationButtonLayout="shorts_camera"
        yt:iconDrawable="@drawable/yt_outline_volume_on_white_24"/>
    <LinearLayout
        android:id="@+id/shorts_post_button"
        android:paddingLeft="@dimen/reel_edit_bottom_bar_post_button_layout_padding"
        android:paddingTop="@dimen/reel_edit_toolbar_button_container_top_padding"
        android:paddingRight="@dimen/reel_edit_bottom_bar_post_button_layout_padding"
        android:paddingBottom="@dimen/reel_edit_toolbar_button_container_top_padding"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/reel_edit_bottom_bar_post_button_container_height"
        android:layout_marginTop="@dimen/shorts_edit_toolbar_button_top_margin"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true">
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:id="@+id/shorts_post_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/shorts_a11y_continue_to_upload"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
    <com.google.android.libraries.youtube.creation.common.ui.CreationButtonView
        android:id="@+id/shorts_post_button_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shorts_edit_toolbar_button_top_margin"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/shorts_a11y_continue_to_upload"
        android:layout_alignParentEnd="true"
        yt:creationButtonLayout="shorts_camera"
        yt:iconBackground="@drawable/shorts_camera_tool_button_inverse_background"
        yt:iconTint="?attr/ytTextPrimaryInverse"/>
</RelativeLayout>
