<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/badge_top_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="40dp"
        yt:layout_constraintBottom_toBottomOf="@+id/badge_icon"
        yt:layout_constraintLeft_toLeftOf="parent"
        yt:layout_constraintRight_toRightOf="parent"/>
    <Space
        android:id="@+id/badge_start_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="28dp"
        yt:layout_constraintBottom_toBottomOf="parent"
        yt:layout_constraintEnd_toEndOf="@+id/badge_icon"
        yt:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/badge_icon"
        android:background="?attr/ytTouchFeedbackCircle"
        android:layout_width="@dimen/yt_sys_measurement_icon_size_hero"
        android:layout_height="@dimen/yt_sys_measurement_icon_size_hero"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        yt:layout_constraintBottom_toBottomOf="parent"
        yt:layout_constraintEnd_toEndOf="parent"
        yt:layout_constraintStart_toStartOf="parent"
        yt:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textSize="10dp"
        android:textColor="?attr/ytOverlayTextPrimary"
        android:gravity="center"
        android:id="@+id/badge_text"
        android:background="@drawable/icon_badge_blue_background"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/yt_sys_measurement_icon_size_cozy"
        android:minWidth="@dimen/yt_sys_measurement_icon_size_cozy"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        yt:layout_constraintEnd_toEndOf="parent"
        yt:layout_constraintStart_toStartOf="@+id/badge_start_anchor"
        yt:layout_constraintTop_toTopOf="@+id/badge_top_anchor"/>
</android.support.constraint.ConstraintLayout>
