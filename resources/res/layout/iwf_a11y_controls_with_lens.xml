<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/reel_a11y_controls"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:layout_marginStart="@dimen/reel_control_group_margin"
        android:layout_marginEnd="@dimen/reel_control_group_margin"
        yt:layout_constraintBottom_toBottomOf="parent"
        yt:layout_constraintEnd_toEndOf="parent"
        yt:layout_constraintStart_toStartOf="parent"
        yt:layout_constraintTop_toTopOf="parent">
        <com.google.android.libraries.youtube.common.ui.CircularImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/reel_prev_reel_button"
            android:background="?attr/ytOverlayBackgroundMediumLight"
            android:padding="@dimen/reel_control_group_button_padding"
            android:focusable="true"
            android:layout_width="@dimen/reel_control_group_icon_size"
            android:layout_height="@dimen/reel_control_group_icon_size"
            android:src="@drawable/quantum_ic_skip_previous_white_36"
            android:contentDescription="@string/reel_accessibility_previous_video"
            android:rotation="90"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/reel_a11y_horizontal_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.libraries.youtube.common.ui.CircularImageView
                android:id="@+id/reel_horizontal_prev_reel_button"
                android:background="?attr/ytOverlayBackgroundMediumLight"
                android:padding="@dimen/reel_control_group_button_padding"
                android:focusable="true"
                android:layout_width="@dimen/reel_control_group_icon_size"
                android:layout_height="@dimen/reel_control_group_icon_size"
                android:src="@drawable/quantum_ic_skip_previous_white_36"
                android:contentDescription="@string/reel_accessibility_previous_video"/>
            <com.google.android.libraries.youtube.common.ui.CircularImageView
                android:id="@+id/reel_play_pause_button"
                android:background="?attr/ytOverlayBackgroundMediumLight"
                android:padding="@dimen/reel_control_group_button_padding"
                android:focusable="true"
                android:layout_width="@dimen/reel_control_group_icon_size"
                android:layout_height="@dimen/reel_control_group_icon_size"
                android:src="@drawable/quantum_ic_pause_white_36"
                android:contentDescription="@string/accessibility_pause"/>
            <com.google.android.libraries.youtube.common.ui.CircularImageView
                android:id="@+id/reel_horizontal_next_reel_button"
                android:background="?attr/ytOverlayBackgroundMediumLight"
                android:padding="@dimen/reel_control_group_button_padding"
                android:focusable="true"
                android:layout_width="@dimen/reel_control_group_icon_size"
                android:layout_height="@dimen/reel_control_group_icon_size"
                android:src="@drawable/quantum_ic_skip_next_white_36"
                android:contentDescription="@string/reel_accessibility_next_video"/>
        </LinearLayout>
        <com.google.android.libraries.youtube.common.ui.CircularImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/reel_next_reel_button"
            android:background="?attr/ytOverlayBackgroundMediumLight"
            android:padding="@dimen/reel_control_group_button_padding"
            android:focusable="true"
            android:layout_width="@dimen/reel_control_group_icon_size"
            android:layout_height="@dimen/reel_control_group_icon_size"
            android:src="@drawable/quantum_ic_skip_next_white_36"
            android:contentDescription="@string/reel_accessibility_next_video"
            android:rotation="90"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/a11y_controls_lens_paused_state_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        yt:layout_constraintEnd_toEndOf="parent"
        yt:layout_constraintStart_toStartOf="parent"
        yt:layout_constraintTop_toBottomOf="@+id/reel_a11y_controls"/>
</androidx.constraintlayout.widget.ConstraintLayout>
