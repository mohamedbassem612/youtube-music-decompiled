<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/ytBrandBackgroundSolid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.libraries.youtube.common.ui.YouTubeTextView
                android:textColor="?attr/ytTextSecondary"
                android:layout_gravity="center_vertical"
                android:id="@+id/header_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/live_chat_context_menu_bottom_sheet_vertical_padding"
                android:layout_marginBottom="@dimen/live_chat_context_menu_bottom_sheet_vertical_padding"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/live_chat_context_menu_bottom_sheet_horizontal_padding"
                android:layout_marginEnd="@dimen/live_chat_context_menu_bottom_sheet_horizontal_padding"/>
            <View
                android:id="@+id/separator"
                android:background="?attr/yt10PercentLayer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/yt_sys_measurement_size_hairline"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/menu_container"
                android:paddingTop="@dimen/live_chat_context_menu_bottom_sheet_items_container_vertical_padding"
                android:paddingBottom="@dimen/live_chat_context_menu_bottom_sheet_items_container_vertical_padding"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
