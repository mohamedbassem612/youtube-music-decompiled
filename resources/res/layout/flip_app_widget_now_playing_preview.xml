<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/FlexWindow.NoRadius"
    android:orientation="vertical"
    android:id="@android:id/background"
    android:paddingBottom="@dimen/flex_window_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/AAG.AppWidget.Background">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/widget_controls_container"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/flex_window_metadata_controls_container_margin"
        style="@style/AAG.AppWidget.Container">
        <ImageButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/album_art"
            android:padding="0dp"
            android:layout_width="@dimen/flex_window_large_album_art_size"
            android:layout_height="@dimen/flex_window_large_album_art_size"
            android:src="@drawable/chappell_roan_single_preview_large"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:layout_marginEnd="@dimen/flex_window_primary_album_art_margin_end"
            style="@style/AAG.AppWidget.Container.SurfaceVariant"/>
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:id="@+id/metadata_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/top_row"
                android:padding="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="?android:attr/textAppearance"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:id="@+id/trackname"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/flip_widget_preview_song"
                    android:maxLines="2"
                    android:layout_weight="1"
                    android:fontFamily="google-sans"/>
                <ImageButton
                    android:id="@+id/ytm_logo"
                    android:layout_width="@dimen/flex_window_ytm_logo_size"
                    android:layout_height="@dimen/flex_window_ytm_logo_size"
                    android:src="@drawable/ic_stat_ytmusic_white"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/mbs_notification_tap_to_open"
                    style="@style/AAG.AppWidget.Button.Borderless"/>
            </LinearLayout>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:ellipsize="end"
                android:id="@+id/byline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flip_widget_preview_artist"
                android:maxLines="1"
                android:fontFamily="google-sans-text"/>
            <LinearLayout
                android:layout_gravity="end|bottom"
                android:orientation="horizontal"
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <ImageButton
                    android:layout_gravity="end|bottom"
                    android:id="@+id/like_button"
                    android:padding="@dimen/flex_window_controls_padding"
                    android:layout_width="@dimen/flex_window_like_button_icon_width"
                    android:layout_height="@dimen/flex_window_controls_icon_size"
                    android:src="@drawable/quantum_gm_ic_thumb_up_vd_theme_24"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/accessibility_like_video"
                    android:layout_marginEnd="@dimen/flex_window_controls_margin"
                    style="@style/AAG.AppWidget.Button.Secondary"/>
                <ImageButton
                    android:layout_gravity="end|bottom"
                    android:id="@+id/play_pause_button"
                    android:layout_width="@dimen/flex_window_controls_icon_size"
                    android:layout_height="@dimen/flex_window_controls_icon_size"
                    android:src="@drawable/quantum_ic_play_arrow_vd_theme_24"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/accessibility_play"
                    style="@style/AAG.AppWidget.Button.Primary"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widget_play_history_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/AAG.AppWidget.Container.SurfaceVariant">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/widget_play_history_container_row_one"
            android:layout_width="match_parent"
            android:layout_height="@dimen/flex_window_recently_played_item_size">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_icon_1"
                android:padding="0dp"
                android:layout_width="@dimen/flex_window_recently_played_item_size"
                android:layout_height="@dimen/flex_window_recently_played_item_size"
                android:src="@drawable/megan_preview"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                style="@style/AAG.AppWidget.Container"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_icon_2"
                android:padding="0dp"
                android:layout_width="@dimen/flex_window_recently_played_item_size"
                android:layout_height="@dimen/flex_window_recently_played_item_size"
                android:src="@drawable/shaboozey_preview"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                style="@style/AAG.AppWidget.Container"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_icon_3"
                android:padding="0dp"
                android:layout_width="@dimen/flex_window_recently_played_item_size"
                android:layout_height="@dimen/flex_window_recently_played_item_size"
                android:src="@drawable/charli_xcx_preview"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                style="@style/AAG.AppWidget.Container"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_icon_4"
                android:padding="0dp"
                android:layout_width="@dimen/flex_window_recently_played_item_size"
                android:layout_height="@dimen/flex_window_recently_played_item_size"
                android:src="@drawable/remi_wolf_preview"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                style="@style/AAG.AppWidget.Container"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_icon_5"
                android:padding="0dp"
                android:layout_width="@dimen/flex_window_recently_played_item_size"
                android:layout_height="@dimen/flex_window_recently_played_item_size"
                android:src="@drawable/sabrina_espresso_preview"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                style="@style/AAG.AppWidget.Container"/>
            <FrameLayout
                android:id="@+id/widget_row_one_end_space"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/widget_play_history_container_row_two"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_icon_size">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_icon_6"
                android:padding="0dp"
                android:layout_width="@dimen/flex_window_recently_played_item_size"
                android:layout_height="@dimen/flex_window_recently_played_item_size"
                android:src="@drawable/channel_tres_preview"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                style="@style/AAG.AppWidget.Container"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_icon_7"
                android:padding="0dp"
                android:layout_width="@dimen/flex_window_recently_played_item_size"
                android:layout_height="@dimen/flex_window_recently_played_item_size"
                android:src="@drawable/latto_preview"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                style="@style/AAG.AppWidget.Container"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_icon_8"
                android:padding="0dp"
                android:layout_width="@dimen/flex_window_recently_played_item_size"
                android:layout_height="@dimen/flex_window_recently_played_item_size"
                android:src="@drawable/anitta_preview"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                style="@style/AAG.AppWidget.Container"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_icon_9"
                android:padding="0dp"
                android:layout_width="@dimen/flex_window_recently_played_item_size"
                android:layout_height="@dimen/flex_window_recently_played_item_size"
                android:src="@drawable/lucky_daye_preview"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                style="@style/AAG.AppWidget.Container"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_icon_10"
                android:padding="0dp"
                android:layout_width="@dimen/flex_window_recently_played_item_size"
                android:layout_height="@dimen/flex_window_recently_played_item_size"
                android:src="@drawable/rauw_alejandro_preview"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                style="@style/AAG.AppWidget.Container"/>
            <FrameLayout
                android:id="@+id/widget_row_two_end_space"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
