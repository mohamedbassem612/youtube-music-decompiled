<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="24sp"
        android:textColor="?attr/ytTextPrimary"
        android:id="@+id/dialog_title"
        android:paddingLeft="22dp"
        android:paddingTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"/>
    <View
        android:id="@+id/suggested_devices_bar"
        android:background="?attr/yt10PercentLayer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/yt_sys_measurement_size_hairline"
        android:layout_margin="1dp"/>
    <TextView
        android:textSize="18sp"
        android:textColor="?attr/ytTextPrimary"
        android:id="@+id/suggested_devices_subtitle"
        android:paddingLeft="24dp"
        android:paddingTop="@dimen/mdx_media_route_dialog_section_spacing"
        android:paddingBottom="@dimen/mdx_media_route_dialog_section_spacing"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/suggested_devices_chip_cloud"
        android:paddingLeft="20dp"
        android:paddingTop="@dimen/mdx_media_route_dialog_section_spacing"
        android:paddingBottom="@dimen/mdx_media_route_dialog_section_spacing"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/mdx_media_route_dialog_section_spacing"/>
    <View
        android:id="@+id/all_devices_bar"
        android:background="?attr/yt10PercentLayer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/yt_sys_measurement_size_hairline"
        android:layout_margin="1dp"/>
    <TextView
        android:textSize="18sp"
        android:textColor="?attr/ytTextPrimary"
        android:id="@+id/all_devices_subtitle"
        android:paddingLeft="24dp"
        android:paddingTop="@dimen/mdx_media_route_dialog_section_spacing"
        android:paddingBottom="@dimen/mdx_media_route_dialog_section_spacing"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ListView
        android:id="@+id/list_of_routes"
        android:paddingTop="20dp"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:layout_weight="1"/>
    <android.support.constraint.ConstraintLayout
        android:id="@android:id/empty"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ProgressBar
            android:gravity="center_vertical"
            android:id="@+id/progress_bar"
            android:layout_width="@dimen/yt_sys_measurement_size_comfortable"
            android:layout_height="@dimen/yt_sys_measurement_size_comfortable"
            android:indeterminate="true"
            android:contentDescription="@string/mdx_searching_for_devices_progress_bar_content_description"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?android:attr/progressBarStyle"/>
        <Space
            android:id="@+id/space"
            android:layout_width="22dp"
            android:layout_height="22dp"
            app:layout_constraintLeft_toRightOf="@+id/progress_bar"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/ytTextPrimary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/search_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:singleLine="false"
            app:layout_constraintLeft_toRightOf="@+id/space"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="16sp"
            android:textColor="?attr/ytTextPrimary"
            android:id="@+id/link_with_tv_code"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="32dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mdx_media_route_dialog_footer_link_with_tv_code"
            android:drawablePadding="24dp"
            android:contentDescription="@string/mdx_accessibility_footer_link_with_tv_code"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/search_status"
            app:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_l_default"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="14sp"
            android:textColor="?attr/ytTextPrimary"
            android:id="@+id/learn_more"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mdx_media_route_dialog_footer_learn_more"
            android:drawablePadding="24dp"
            android:contentDescription="@string/mdx_accessibility_footer_learn_more"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/link_with_tv_code"
            app:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_m_default"/>
    </android.support.constraint.ConstraintLayout>
    <View
        android:id="@+id/separator"
        android:background="?attr/ytGeneralBackgroundC"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/yt_sys_measurement_size_hairline"/>
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textSize="14sp"
        android:textColor="?attr/ytTextSecondary"
        android:id="@+id/cast_setting_desc"
        android:paddingLeft="24dp"
        android:paddingTop="16dp"
        android:paddingRight="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mdx_cast_settings_desc"
        app:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_m_default"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/go_to_cast_settings"
        android:background="?android:attr/selectableItemBackground"
        android:paddingLeft="24dp"
        android:paddingTop="12dp"
        android:paddingRight="24dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="14sp"
            android:textColor="?attr/ytCallToAction"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/mdx_go_to_cast_settings"
            app:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_m_default"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/quantum_ic_open_in_new_googblue_18"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
