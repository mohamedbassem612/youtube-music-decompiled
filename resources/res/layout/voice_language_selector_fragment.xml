<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/ytRaisedBackground"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/large_font_size"
        android:textStyle="bold"
        android:textColor="?attr/ytTextPrimary"
        android:id="@+id/title"
        android:paddingTop="24dp"
        android:paddingBottom="22dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:lineHeight="24dp"/>
    <View
        android:id="@+id/header_separator"
        android:background="?attr/ytOutline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/yt_sys_measurement_size_hairline"/>
    <ScrollView
        android:orientation="vertical"
        android:id="@+id/scroll_view"
        android:scrollbars="vertical"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioGroup
                android:id="@+id/suggested_language_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/language_group_separator"
                android:background="?attr/ytOutline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/yt_sys_measurement_size_hairline"
                android:layout_marginTop="3dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <RadioGroup
                android:id="@+id/all_language_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/footer_separator"
        android:background="?attr/ytOutline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/yt_sys_measurement_size_hairline"/>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/small_font_size"
            android:textStyle="bold"
            android:textColor="?attr/ytCallToAction"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/cancel_button"
            android:background="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/yt_sys_measurement_size_prominent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:textAllCaps="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="@dimen/small_font_size"
            android:textStyle="bold"
            android:textColor="?attr/ytCallToAction"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/apply_button"
            android:background="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/yt_sys_measurement_size_prominent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:textAllCaps="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
</LinearLayout>
