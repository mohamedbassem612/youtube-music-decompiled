<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/devicepicker_route_with_volume_container_padding_top"
    android:paddingBottom="@dimen/devicepicker_route_with_volume_container_padding_bottom"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/devicepicker_route_with_volume_container_min_height"
    android:paddingStart="@dimen/devicepicker_route_container_padding_start"
    android:paddingEnd="@dimen/devicepicker_route_with_volume_container_padding_end">
    <ImageView
        android:id="@+id/device_picker_route_icon"
        android:layout_width="@dimen/devicepicker_route_icon_layout_width"
        android:layout_height="@dimen/devicepicker_route_icon_layout_height"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/devicepicker_route_icon_margin_start"
        android:layout_marginEnd="@dimen/devicepicker_route_icon_margin_end"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/textHolder"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textAppearance="?attr/ytTextAppearanceTitle2"
            android:ellipsize="marquee"
            android:gravity="start"
            android:id="@+id/device_picker_route_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"/>
        <SeekBar
            android:id="@+id/device_picker_route_volume_slider"
            android:background="@android:color/transparent"
            android:paddingTop="@dimen/devicepicker_route_volume_slider_padding_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:thumbOffset="4dp"
            android:paddingStart="0dp"/>
    </LinearLayout>
    <ImageButton
        android:id="@+id/overflow_button"
        android:layout_width="@dimen/devicepicker_route_with_volume_container_overflow_button_width"
        android:layout_height="@dimen/devicepicker_route_with_volume_container_overflow_button_height"
        android:src="@drawable/yt_outline_overflow_vertical_vd_theme_24"
        android:contentDescription="@string/overflow_button_content_description"
        style="?android:attr/actionButtonStyle"/>
</LinearLayout>
