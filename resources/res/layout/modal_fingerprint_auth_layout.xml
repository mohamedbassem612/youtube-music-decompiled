<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="280dp"
    android:minHeight="450dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <android.support.v7.widget.AppCompatImageView
            android:layout_gravity="end"
            android:id="@+id/close_button"
            android:paddingBottom="6dp"
            android:layout_width="@dimen/material_min_touch_target"
            android:layout_height="@dimen/material_min_touch_target"
            android:src="@drawable/quantum_ic_close_black_24"
            android:scaleType="center"
            android:tint="?attr/ytIcon1"
            android:contentDescription="@string/close_auth_dialog"
            yt:layout_constraintEnd_toEndOf="parent"
            yt:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="18sp"
            android:textColor="?attr/ytTextPrimary"
            android:id="@+id/title"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            yt:layout_constraintTop_toBottomOf="@+id/close_button"
            yt:robotoFont="medium"
            yt:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_xl_heavy"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="14sp"
            android:textColor="?attr/ytTextPrimary"
            android:id="@+id/description"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            yt:layout_constraintTop_toBottomOf="@+id/title"
            yt:robotoFont="regular"
            yt:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_m_default"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="14sp"
            android:textColor="?attr/ytTextPrimary"
            android:textColorLink="?attr/ytThemedBlue"
            android:id="@+id/other_methods_field"
            android:paddingBottom="74dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            yt:hyperlinksClickable="true"
            yt:layout_constraintTop_toBottomOf="@+id/description"
            yt:robotoFont="regular"
            yt:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_m_default"/>
        <ImageView
            android:id="@+id/fingerprint_icon"
            android:paddingBottom="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/quantum_ic_fingerprint_grey600_48"
            android:contentDescription="@string/fingerprint_icon_description"
            yt:layout_constraintEnd_toEndOf="parent"
            yt:layout_constraintStart_toStartOf="parent"
            yt:layout_constraintTop_toBottomOf="@+id/other_methods_field"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="12sp"
            android:textColor="?attr/ytTextPrimary"
            android:id="@+id/fingerprint_label"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirm_by_touching_sensor"
            yt:layout_constraintEnd_toEndOf="parent"
            yt:layout_constraintStart_toStartOf="parent"
            yt:layout_constraintTop_toBottomOf="@+id/fingerprint_icon"
            yt:robotoFont="regular"
            yt:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_s_default"/>
        <CheckBox
            android:textSize="12sp"
            android:id="@+id/reauth_opt_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="65dp"
            android:layout_marginBottom="0dp"
            android:paddingStart="8dp"
            yt:layout_constraintEnd_toEndOf="parent"
            yt:layout_constraintStart_toStartOf="parent"
            yt:layout_constraintTop_toBottomOf="@+id/fingerprint_label"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="12sp"
            android:textColor="?attr/ytBrandRed"
            android:gravity="center"
            android:id="@+id/error_message_field"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            yt:layout_constraintEnd_toEndOf="parent"
            yt:layout_constraintStart_toStartOf="parent"
            yt:layout_constraintTop_toBottomOf="@+id/fingerprint_label"
            yt:robotoFont="regular"
            yt:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_s_default"/>
        <com.google.android.libraries.youtube.common.ui.YouTubeTextView
            android:textSize="12sp"
            android:textColor="?attr/ytThemedBlue"
            android:gravity="center"
            android:id="@+id/use_password_field"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/use_password_instead"
            yt:layout_constraintEnd_toEndOf="parent"
            yt:layout_constraintStart_toStartOf="parent"
            yt:layout_constraintTop_toBottomOf="@+id/error_message_field"
            yt:robotoFont="regular"
            yt:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_s_default"/>
    </android.support.constraint.ConstraintLayout>
</ScrollView>
