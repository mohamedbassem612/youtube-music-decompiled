<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/hats_response_icon"
        android:layout_width="@dimen/yt_sys_measurement_icon_size_comfortable"
        android:layout_height="@dimen/yt_sys_measurement_icon_size_comfortable"
        android:minWidth="@dimen/yt_sys_measurement_icon_size_comfortable"
        android:contentDescription="@null"
        android:layout_marginEnd="16dp"/>
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textAppearance="?attr/textAppearanceBody1"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="start|center_vertical"
        android:id="@+id/hats_response_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAlignment="viewStart"/>
</LinearLayout>
