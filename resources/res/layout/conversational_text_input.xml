<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:paddingHorizontal="@dimen/item_large_spacing"
    android:paddingVertical="@dimen/item_small_spacing">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="@dimen/item_extra_small_spacing"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="@dimen/legacy_conversation_input_size"
            android:layout_weight="1">
            <com.google.android.apps.youtube.music.ui.text.PlainTextEditText
                android:textAppearance="@style/YtmBody01"
                android:textColorHint="?attr/ytOverlayTextSecondary"
                android:ellipsize="end"
                android:id="@+id/text_input"
                android:background="@drawable/search_query_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/ask_any_way_you_like_prompt"
                android:maxLines="1"
                android:inputType="textFilter"
                android:imeOptions="flagNoFullscreen|actionGo"
                android:textAlignment="viewStart"
                android:paddingStart="@dimen/item_extra_large_spacing"
                android:paddingEnd="@dimen/search_header_text_padding_end"/>
            <android.support.v7.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/text_input_clear"
                android:padding="@dimen/small_action_bar_icon_padding"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="@dimen/microphone_button_icon_size"
                android:layout_height="@dimen/microphone_button_icon_size"
                android:scaleType="centerInside"
                android:contentDescription="@string/clear_text_end_icon_content_description"
                app:srcCompat="@drawable/yt_outline_x_mark_vd_theme_24"
                app:tint="@color/quantum_white_100"
                style="@style/Widget.AppCompat.ActionButton"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/text_input_mic_indicator"
                android:focusable="false"
                android:visibility="gone"
                android:layout_width="@dimen/microphone_button_icon_size"
                android:layout_height="@dimen/microphone_button_icon_size"
                android:scaleType="centerInside"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/voice_search"
                app:lottie_renderMode="hardware"
                app:lottie_speed="1"/>
            <android.support.v7.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/text_input_mic_background"
                android:focusable="false"
                android:visibility="gone"
                android:layout_width="@dimen/microphone_button_icon_size"
                android:layout_height="@dimen/microphone_button_icon_size"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/text_input_mic_background"/>
            <android.support.v7.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/text_input_mic"
                android:padding="@dimen/small_action_bar_icon_padding"
                android:focusable="true"
                android:layout_width="@dimen/microphone_button_icon_size"
                android:layout_height="@dimen/microphone_button_icon_size"
                android:scaleType="centerInside"
                android:contentDescription="@string/accessibility_voice_search"
                app:srcCompat="@drawable/yt_outline_mic_vd_theme_24"
                app:tint="@color/quantum_white_100"
                style="@style/Widget.AppCompat.ActionButton"/>
            <android.support.v7.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/text_input_submit"
                android:background="@drawable/conversational_text_input_submit_background"
                android:padding="@dimen/text_input_submit_padding"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="@dimen/microphone_button_icon_size"
                android:layout_height="@dimen/microphone_button_icon_size"
                android:scaleType="centerInside"
                android:contentDescription="@string/ask_music_submit_button"
                app:srcCompat="@drawable/yt_outline_experimental_arrow_up_vd_theme_24"
                app:tint="?attr/ytStaticBrandBlack"
                style="@style/Widget.AppCompat.ActionButton"/>
        </FrameLayout>
        <android.support.v7.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/submit"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="@dimen/legacy_conversation_input_size"
            android:layout_height="@dimen/legacy_conversation_input_size"
            android:scaleType="centerCrop"
            android:contentDescription="@string/ask_music_submit_button"
            android:layout_marginStart="@dimen/item_medium_spacing"
            app:srcCompat="@drawable/yt_fill_play_arrow_circle_vd_theme_24"
            app:tint="@color/submit_state_colors"
            style="@style/Widget.AppCompat.ActionButton"/>
    </LinearLayout>
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textAppearance="@style/YtmTextLabel02"
        android:textColor="?attr/ytOverlayTextSecondary"
        android:textColorLink="@color/ytm_color_white"
        android:gravity="start"
        android:id="@+id/input_disclaimer"
        android:paddingTop="@dimen/item_extra_small_spacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ai_feature_input_disclaimer"
        app:typographyAppearanceToken="?attr/yt_sys_typography_typestack_body_xs_default"/>
</LinearLayout>
