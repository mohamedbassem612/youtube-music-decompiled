<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/account"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <FrameLayout
        android:gravity="center"
        android:id="@+id/selection_highlight"
        android:background="@drawable/fusion_selected_account_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp">
        <com.google.android.libraries.youtube.common.ui.CircularImageView
            android:id="@+id/thumbnail"
            android:layout_width="@dimen/account_switcher_thumbnail_size"
            android:layout_height="@dimen/account_switcher_thumbnail_size"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/user_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.libraries.youtube.common.ui.YouTubeTextView
                    android:textSize="@dimen/medium_font_size"
                    android:textColor="?attr/ytTextPrimary"
                    android:ellipsize="end"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    yt:robotoFont="regular"/>
                <ImageView
                    android:id="@+id/icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tint="?attr/ytIconInactive"
                    android:contentDescription="@null"
                    android:paddingStart="4dp"/>
            </LinearLayout>
            <com.google.android.libraries.youtube.common.ui.YouTubeTextView
                android:textColor="?attr/ytTextSecondary"
                android:ellipsize="end"
                android:id="@+id/channel_handle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <com.google.android.libraries.youtube.common.ui.YouTubeTextView
                android:textColor="?attr/ytTextSecondary"
                android:ellipsize="end"
                android:id="@+id/byline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
            <com.google.android.libraries.youtube.common.ui.YouTubeButton
                android:textColor="?attr/ytCallToAction"
                android:ellipsize="end"
                android:id="@+id/edit_channel"
                android:paddingTop="7dp"
                android:paddingBottom="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/selection_checkmark"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/yt_outline_check_black_24"
            android:tint="?attr/ytCallToAction"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/app_redirection_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/yt_outline_open_new_vd_theme_24"
            android:tint="?attr/ytTextPrimary"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/arrow_up_right_app_redirection_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/yt_outline_experimental_arrow_up_right_vd_theme_24"
            android:tint="?attr/ytTextPrimary"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/offline_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/yt_outline_cloud_off_vd_theme_24"
            android:tint="?attr/ytTextPrimary"
            android:contentDescription="@null"/>
    </LinearLayout>
</LinearLayout>
