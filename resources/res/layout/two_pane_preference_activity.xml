<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <com.google.android.apps.youtube.music.ui.appchrome.insets.InsetAdjustingToolbar
            android:id="@+id/toolbar"
            android:background="@color/ytm_theme_main_color_dark"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/navigate_back"
            app:navigationIcon="@drawable/yt_outline_arrow_left_white_24"/>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/root_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:paddingHorizontal="@dimen/page_margin">
        <FrameLayout
            android:id="@+id/headers_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/gutter_width"/>
        <View
            android:background="@color/ytm_color_white_at_20pct"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"/>
    </LinearLayout>
</LinearLayout>
