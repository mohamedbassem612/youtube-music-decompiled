<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:id="@+id/unicorn_password_auth_container"
    android:visibility="gone"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/unicorn_password_auth_background"
        android:background="?attr/ytRaisedBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        yt:layout_constraintBottom_toBottomOf="parent"
        yt:layout_constraintEnd_toEndOf="parent"
        yt:layout_constraintStart_toStartOf="parent"
        yt:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/unicorn_password_auth_scroll_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_container_padding"
        android:maxHeight="@dimen/dialog_maximum_height"
        android:minHeight="@dimen/dialog_minimum_height"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/dialog_container_padding_half"
        yt:layout_constraintBottom_toTopOf="@+id/button_container"
        yt:layout_constraintEnd_toEndOf="parent"
        yt:layout_constraintStart_toStartOf="parent"
        yt:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dialog_container_padding_half">
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/google_logo"
                android:layout_width="@dimen/dialog_google_logo_size"
                android:layout_height="@dimen/dialog_google_logo_size"
                android:scaleType="fitXY"
                android:importantForAccessibility="no"
                yt:layout_constraintBottom_toTopOf="@+id/dialog_title"
                yt:layout_constraintStart_toStartOf="parent"
                yt:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
                android:textStyle="bold"
                android:textColor="?attr/ytTextPrimary"
                android:gravity="start"
                android:id="@+id/dialog_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sign_in"
                android:textDirection="locale"
                android:paddingVertical="@dimen/dialog_component_padding_vertical"
                yt:layout_constraintBottom_toTopOf="@+id/dialog_description"
                yt:layout_constraintEnd_toEndOf="parent"
                yt:layout_constraintStart_toStartOf="parent"
                yt:layout_constraintTop_toBottomOf="@+id/google_logo"/>
            <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
                android:textStyle="bold"
                android:textColor="?attr/ytTextPrimary"
                android:id="@+id/dialog_description"
                android:paddingBottom="@dimen/dialog_component_padding_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_description"
                android:textDirection="locale"
                yt:layout_constraintBottom_toTopOf="@+id/profile_container"
                yt:layout_constraintEnd_toEndOf="parent"
                yt:layout_constraintStart_toStartOf="parent"
                yt:layout_constraintTop_toBottomOf="@+id/dialog_title"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profile_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dialog_component_padding_vertical"
                yt:layout_constraintBottom_toTopOf="@+id/password_container"
                yt:layout_constraintEnd_toEndOf="parent"
                yt:layout_constraintStart_toStartOf="parent"
                yt:layout_constraintTop_toBottomOf="@+id/dialog_description">
                <com.google.android.libraries.youtube.common.ui.CircularImageView
                    android:id="@+id/avatar"
                    android:layout_width="@dimen/profile_avatar_size"
                    android:layout_height="@dimen/profile_avatar_size"
                    android:scaleType="fitXY"
                    yt:layout_constraintBottom_toBottomOf="parent"
                    yt:layout_constraintStart_toStartOf="parent"
                    yt:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/avatar_gap_view"
                    android:background="@android:color/transparent"
                    android:layout_width="@dimen/profile_avatar_padding_end"
                    android:layout_height="0dp"
                    yt:layout_constraintBottom_toBottomOf="parent"
                    yt:layout_constraintEnd_toStartOf="@+id/title"
                    yt:layout_constraintStart_toEndOf="@+id/avatar"
                    yt:layout_constraintTop_toTopOf="parent"/>
                <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
                    android:textStyle="bold"
                    android:textColor="?attr/ytTextPrimary"
                    android:gravity="start"
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textDirection="locale"
                    yt:layout_constraintBottom_toTopOf="@+id/description"
                    yt:layout_constraintEnd_toEndOf="parent"
                    yt:layout_constraintStart_toEndOf="@+id/avatar_gap_view"
                    yt:layout_constraintTop_toTopOf="parent"/>
                <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
                    android:textStyle="bold"
                    android:textColor="?attr/ytTextSecondary"
                    android:gravity="start"
                    android:id="@+id/description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textDirection="locale"
                    yt:layout_constraintBottom_toBottomOf="parent"
                    yt:layout_constraintEnd_toEndOf="parent"
                    yt:layout_constraintStart_toEndOf="@+id/avatar_gap_view"
                    yt:layout_constraintTop_toBottomOf="@+id/title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/password_container"
                android:background="@drawable/text_field_border"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_component_padding_vertical"
                android:minHeight="60dp"
                android:paddingHorizontal="@dimen/dialog_component_padding_horizontal"
                android:paddingVertical="@dimen/dialog_component_padding_vertical"
                yt:layout_constraintBottom_toTopOf="@+id/error_container"
                yt:layout_constraintEnd_toEndOf="parent"
                yt:layout_constraintStart_toStartOf="parent"
                yt:layout_constraintTop_toBottomOf="@+id/profile_container">
                <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
                    android:textColor="?attr/ytTextSecondary"
                    android:gravity="start"
                    android:id="@+id/password_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/password_title"
                    android:textDirection="locale"
                    android:labelFor="@+id/password_field"
                    yt:layout_constraintEnd_toEndOf="parent"
                    yt:layout_constraintStart_toStartOf="parent"
                    yt:layout_constraintTop_toTopOf="parent"/>
                <EditText
                    android:textColorHighlight="?attr/ytTextPrimary"
                    android:state_focused="true"
                    android:id="@+id/password_field"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:textDirection="locale"
                    yt:layout_constraintEnd_toStartOf="@+id/password_visibility_icon"
                    yt:layout_constraintStart_toStartOf="parent"
                    yt:layout_constraintTop_toBottomOf="@+id/password_title"/>
                <ImageView
                    android:id="@+id/password_visibility_icon"
                    android:layout_width="@dimen/password_icon_size"
                    android:layout_height="@dimen/password_icon_size"
                    android:tint="?attr/ytTextPrimary"
                    android:contentDescription="@string/password_visibility_toggle"
                    android:layout_marginStart="@dimen/dialog_component_padding_horizontal"
                    yt:layout_constraintBottom_toBottomOf="@+id/password_field"
                    yt:layout_constraintEnd_toEndOf="parent"
                    yt:layout_constraintStart_toEndOf="@+id/password_field"
                    yt:layout_constraintTop_toTopOf="@+id/password_field"
                    yt:layout_constraintVertical_bias="0.5"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/error_container"
                android:paddingTop="4dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                yt:layout_constraintBottom_toTopOf="@+id/forgot_password_field"
                yt:layout_constraintEnd_toEndOf="parent"
                yt:layout_constraintStart_toStartOf="parent"
                yt:layout_constraintTop_toBottomOf="@+id/password_container">
                <ImageView
                    android:id="@+id/error_icon"
                    android:layout_width="@dimen/error_icon_size"
                    android:layout_height="@dimen/error_icon_size"
                    android:tint="?attr/ytErrorIndicator"
                    android:importantForAccessibility="no"
                    yt:layout_constraintStart_toStartOf="parent"
                    yt:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/error_icon_gap_view"
                    android:background="@android:color/transparent"
                    android:layout_width="@dimen/dialog_error_message_gap_horizontal"
                    android:layout_height="0dp"
                    yt:layout_constraintBottom_toBottomOf="parent"
                    yt:layout_constraintStart_toEndOf="@+id/error_icon"
                    yt:layout_constraintTop_toTopOf="parent"/>
                <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
                    android:textColor="?attr/ytErrorIndicator"
                    android:id="@+id/error_message_field"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    yt:layout_constraintEnd_toEndOf="parent"
                    yt:layout_constraintStart_toEndOf="@+id/error_icon_gap_view"
                    yt:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
                android:gravity="center"
                android:id="@+id/forgot_password_field"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dialog_button_height"
                yt:layout_constraintBottom_toBottomOf="parent"
                yt:layout_constraintStart_toStartOf="parent"
                yt:layout_constraintTop_toBottomOf="@+id/error_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <View
        android:id="@+id/divider_view"
        android:background="?attr/yt10PercentLayer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/yt_sys_measurement_size_hairline"
        yt:layout_constraintBottom_toTopOf="@+id/button_container"
        yt:layout_constraintEnd_toEndOf="parent"
        yt:layout_constraintStart_toStartOf="parent"
        yt:layout_constraintTop_toBottomOf="@+id/unicorn_password_auth_scroll_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_container"
        android:background="?attr/ytRaisedBackground"
        android:paddingTop="@dimen/dialog_footer_padding"
        android:paddingBottom="@dimen/dialog_container_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dialog_container_padding"
        yt:layout_constraintBottom_toBottomOf="parent"
        yt:layout_constraintEnd_toEndOf="parent"
        yt:layout_constraintStart_toStartOf="parent"
        yt:layout_constraintTop_toBottomOf="@+id/divider_view">
        <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
            android:gravity="center"
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_button_height"
            yt:layout_constraintBottom_toBottomOf="parent"
            yt:layout_constraintEnd_toStartOf="@+id/action_button_gap_view"
            yt:layout_constraintStart_toStartOf="parent"
            yt:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/action_button_gap_view"
            android:background="@android:color/transparent"
            android:layout_width="@dimen/action_button_gap_view"
            android:layout_height="0dp"
            yt:layout_constraintBottom_toBottomOf="parent"
            yt:layout_constraintEnd_toStartOf="@+id/confirm_button"
            yt:layout_constraintStart_toEndOf="@+id/cancel_button"
            yt:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
            android:gravity="center"
            android:id="@+id/confirm_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_button_height"
            yt:layout_constraintBottom_toBottomOf="parent"
            yt:layout_constraintEnd_toEndOf="parent"
            yt:layout_constraintStart_toEndOf="@+id/action_button_gap_view"
            yt:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
