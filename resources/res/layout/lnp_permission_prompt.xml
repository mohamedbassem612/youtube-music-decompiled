<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="?attr/ytBrandBackgroundSolid"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/lnp_permission_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:src="@drawable/mdx_local_network_permissions_light"
        android:importantForAccessibility="no"/>
    <TextView
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="?attr/ytTextPrimary"
        android:gravity="center"
        android:id="@+id/lnp_permission_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/lnp_permission_prompt_title"
        android:accessibilityHeading="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/ytTextSecondary"
        android:gravity="center"
        android:id="@+id/lnp_permission_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="@string/lnp_permission_prompt_subtitle"
        android:contentDescription="@string/lnp_permission_prompt_subtitle_content_description"/>
    <com.google.android.libraries.youtube.common.ui.YouTubeButton
        android:textStyle="bold"
        android:textColor="?attr/ytFilledButtonText"
        android:gravity="center"
        android:id="@+id/go_to_settings_button"
        android:background="@drawable/lnp_permission_button_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/yt_sys_measurement_action_height_prominent"
        android:layout_marginBottom="16dp"
        android:text="@string/lnp_permission_prompt_go_to_settings"
        android:textAllCaps="false"/>
    <com.google.android.libraries.youtube.common.ui.YouTubeButton
        android:textStyle="bold"
        android:textColor="?attr/ytTextSecondary"
        android:gravity="center"
        android:id="@+id/dismiss_button"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/yt_sys_measurement_action_height_prominent"
        android:text="@string/lnp_permission_prompt_not_now"
        android:textAllCaps="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</LinearLayout>
