<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/AAG.Theme.AppWidget"
    android:orientation="vertical"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/widget_controls_container"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_row_height"
        style="@style/AAG.AppWidget.Background">
        <ImageButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/album_art"
            android:padding="0dp"
            android:layout_width="@dimen/widget_icon_size"
            android:layout_height="@dimen/widget_icon_size"
            android:layout_margin="16dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/widget_album_art_content_description"
            style="@style/AAG.AppWidget.Container.SurfaceVariant"/>
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:id="@+id/metadata_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="92dp">
            <TextView
                android:textAppearance="?android:attr/textAppearance"
                android:textStyle="bold"
                android:ellipsize="end"
                android:id="@+id/trackname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="google-sans"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:ellipsize="end"
                android:id="@+id/byline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="google-sans-text"/>
        </LinearLayout>
        <ImageButton
            android:layout_gravity="end|bottom"
            android:id="@+id/like_button"
            android:padding="4dp"
            android:layout_width="@dimen/yt_sys_measurement_action_height_prominent"
            android:layout_height="@dimen/widget_icon_size"
            android:layout_marginBottom="16dp"
            android:src="@drawable/quantum_gm_ic_thumb_up_vd_theme_24"
            android:scaleType="centerInside"
            android:contentDescription="@string/accessibility_like_video"
            android:layout_marginEnd="84dp"
            style="@style/AAG.AppWidget.Button.Secondary"/>
        <ImageButton
            android:layout_gravity="end|bottom"
            android:id="@+id/play_pause_button"
            android:padding="14dp"
            android:layout_width="@dimen/widget_icon_size"
            android:layout_height="@dimen/widget_icon_size"
            android:layout_marginBottom="16dp"
            android:src="@drawable/quantum_ic_play_arrow_vd_theme_24"
            android:scaleType="centerInside"
            android:contentDescription="@string/accessibility_play"
            android:layout_marginEnd="16dp"
            style="@style/AAG.AppWidget.Button.Primary"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widget_play_history_container"
        android:padding="@dimen/widget_container_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/AAG.AppWidget.Background.SurfaceVariant"/>
</LinearLayout>
