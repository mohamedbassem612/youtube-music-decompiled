<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/media_gen_input_scrim"
        android:background="?attr/ytOverlayBackgroundMedium"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/media_gen_editor_text_input_container"
        android:importantForAccessibility="no"/>
    <include
        android:id="@+id/media_gen_editor_text_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/media_gen_editor_text_input"/>
</RelativeLayout>
