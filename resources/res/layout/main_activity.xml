<?xml version="1.0" encoding="utf-8"?>
<com.google.android.libraries.youtube.common.ui.AccessibilityLayerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:id="@+id/accessibility_layer_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    yt:backgroundViewId="@+id/main_layout_wrapper">
    <fragment
        android:name="com.google.android.apps.youtube.music.util.foreground.ForegroundDetectionFragment"
        android:id="@+id/foreground_detection_fragment"
        android:layout_width="1dp"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/main_layout_wrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/waze_bar_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/watch_while_layout_wrapper"
            android:background="?attr/musicBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ViewStub
                android:id="@+id/stub_watch_while_layout"
                android:inflatedId="@+id/watch_while_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/survey_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_gravity="bottom"
                android:id="@+id/floating_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <include layout="@layout/pivot_bar"/>
            <LinearLayout
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/slim_bar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/interstitials_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/custom_thumbnail_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/engagement_panel_layout"/>
</com.google.android.libraries.youtube.common.ui.AccessibilityLayerLayout>
