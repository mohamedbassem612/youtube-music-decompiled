<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/bottom_sheet_list_item_height"
    android:paddingHorizontal="@dimen/default_content_padding">
    <FrameLayout
        android:id="@+id/list_item_icon_primary_container"
        android:layout_width="@dimen/bottom_sheet_list_icon_size"
        android:layout_height="@dimen/bottom_sheet_list_icon_size"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/bottom_sheet_list_item_text_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="start|center_vertical"
            android:id="@+id/loading_spinner"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateTint="?attr/ytIconInactive"
            style="?android:attr/progressBarStyle"/>
        <android.support.v7.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/list_item_icon_primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tint="?attr/ytIconInactive"
            android:contentDescription="@null"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/list_item_text_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/bottom_sheet_list_item_text_margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/list_item_secondary_container"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/list_item_icon_primary_container"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
            android:textSize="12sp"
            android:textColor="?attr/ytTextSecondary"
            android:gravity="start|center_vertical"
            android:id="@+id/list_item_text_superlabel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"/>
        <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
            android:textColor="?attr/ytTextPrimary"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/list_item_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:singleLine="false"
            android:textAlignment="viewStart"
            style="@style/BottomSheetListText"/>
        <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
            android:textSize="12sp"
            android:textColor="?attr/ytTextSecondary"
            android:gravity="start|center_vertical"
            android:id="@+id/list_item_text_sublabel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/list_item_secondary_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/bottom_sheet_list_item_text_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/list_item_icon_secondary"
            android:layout_width="@dimen/bottom_sheet_list_icon_size"
            android:layout_height="@dimen/bottom_sheet_list_icon_size"
            android:contentDescription="@null"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/list_item_detail_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/ytTextSecondary"
                android:id="@+id/list_item_text_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"/>
            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/list_item_icon_detail"
                android:layout_width="@dimen/yt_sys_measurement_icon_size_compact"
                android:layout_height="@dimen/yt_sys_measurement_icon_size_compact"
                android:src="@drawable/yt_fill_chevron_right_black_24"
                android:tint="?attr/ytIconInactive"
                android:contentDescription="@null"/>
        </LinearLayout>
    </FrameLayout>
</android.support.constraint.ConstraintLayout>
