<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/titleRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:paddingHorizontal="4dp">
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textAppearance="?attr/ytTextAppearanceBody2a"
        android:textColor="?attr/ytTextSecondary"
        android:ellipsize="end"
        android:id="@+id/startAt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"/>
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textAppearance="?attr/ytTextAppearanceBody2b"
        android:textColor="?attr/ytThemedBlue"
        android:ellipsize="end"
        android:id="@+id/startTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:paddingHorizontal="4dp"/>
    <com.google.android.libraries.youtube.common.ui.YouTubeTextView
        android:textAppearance="?attr/ytTextAppearanceBody2b"
        android:ellipsize="end"
        android:id="@+id/contextDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"/>
</LinearLayout>
