<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/ai_image_edit_action_bar"
        android:background="?attr/ytBrandBackgroundSolid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/CompatElevationZ4">
        <android.support.v7.widget.Toolbar
            android:theme="@style/PostsModernActionBar"
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginEnd="@dimen/post_dialog_modern_action_button_right_margin"
            app:navigationContentDescription="@string/accessibility_back"
            app:navigationIcon="@drawable/quantum_ic_arrow_back_white_24"
            app:title="@string/media_gen_image_editor_title"/>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:background="?attr/ytBrandBackgroundSolid"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp">
            <FrameLayout
                android:id="@+id/ai_image_edit_image_wrapper"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/ai_image_edit_quality_disclaimer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <FrameLayout
                    android:id="@+id/ai_image_edit_image_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ai_image_edit_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/media_gen_editor_image_preview_a11y"
                        app:shapeAppearanceOverlay="@style/MediaGenRoundedCorners12dp"/>
                    <FrameLayout
                        android:id="@+id/ai_image_edit_scrim"
                        android:background="?attr/ytOverlayAdditiveBackground"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"/>
                </FrameLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/ai_image_edit_bottom_controller_container"
                android:background="@drawable/media_gen_editor_image_controller_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/media_gen_editor_bottom_controller_height"
                app:layout_constraintBottom_toBottomOf="@+id/ai_image_edit_image_wrapper"
                app:layout_constraintEnd_toEndOf="@+id/ai_image_edit_image_wrapper"
                app:layout_constraintStart_toStartOf="@+id/ai_image_edit_image_wrapper">
                <LinearLayout
                    android:layout_gravity="start|bottom"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/bottom_button_margin">
                    <android.support.v7.widget.AppCompatImageButton
                        android:id="@+id/ai_image_edit_undo_button"
                        android:background="@drawable/media_gen_editor_round_button"
                        android:padding="@dimen/bottom_button_padding"
                        android:layout_width="@dimen/bottom_button_size"
                        android:layout_height="@dimen/bottom_button_size"
                        android:src="@drawable/ic_arrow_undo"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/media_gen_image_editor_undo_a11y"
                        android:layout_marginEnd="@dimen/between_bottom_button_pair_margin"/>
                    <android.support.v7.widget.AppCompatImageButton
                        android:id="@+id/ai_image_edit_redo_button"
                        android:background="@drawable/media_gen_editor_round_button"
                        android:padding="@dimen/bottom_button_padding"
                        android:layout_width="@dimen/bottom_button_size"
                        android:layout_height="@dimen/bottom_button_size"
                        android:src="@drawable/ic_arrow_redo"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/media_gen_image_editor_redo_a11y"/>
                </LinearLayout>
                <Button
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/ai_image_edit_retry_button"
                    android:background="@drawable/media_gen_editor_rounded_button"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/bottom_button_size"
                    android:textAllCaps="false"
                    android:paddingHorizontal="@dimen/bottom_text_button_horizontal_padding"/>
                <include
                    android:layout_gravity="end|bottom"
                    android:orientation="horizontal"
                    android:id="@+id/ai_image_edit_feedback_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/bottom_button_margin"
                    layout="@layout/media_gen_image_editor_feedback_container"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ai_image_edit_progress_container"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_centerInParent="true"
                app:layout_constraintBottom_toTopOf="@+id/ai_image_edit_quality_disclaimer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="?attr/ytStaticWhite"
                    app:trackColor="?attr/ytOverlayButtonSecondary"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?attr/ytOverlayTextPrimary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/ai_image_edit_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:maxLines="3"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"/>
                <com.google.android.material.button.MaterialButton
                    android:theme="@style/Theme.MaterialComponents.DayNight"
                    android:textSize="14sp"
                    android:textColor="?attr/ytOverlayTextPrimary"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ai_image_edit_progress_cancel_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel"
                    android:contentDescription="@string/media_gen_image_editor_cancel_button_a11y"
                    app:backgroundTint="?attr/ytOverlayButtonSecondary"
                    app:rippleColor="?attr/ytOverlayButtonPrimary"
                    style="@style/Widget.Material3.Button.TonalButton"/>
            </LinearLayout>
            <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
                android:textSize="12sp"
                android:textColor="?attr/ytTextSecondary"
                android:id="@+id/ai_image_edit_quality_disclaimer"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toTopOf="@+id/ai_image_edit_text_placeholder"
                app:layout_constraintEnd_toEndOf="@+id/ai_image_edit_image_wrapper"
                app:layout_constraintStart_toStartOf="@+id/ai_image_edit_image_wrapper"
                app:layout_constraintTop_toBottomOf="@+id/ai_image_edit_image_wrapper"/>
            <com.google.android.libraries.youtube.rendering.ui.spec.typography.YouTubeAppCompatTextView
                android:textSize="12sp"
                android:textColor="?attr/ytTextSecondary"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/ai_image_edit_quality_disclaimer_bottom_aligned"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <include
                android:id="@+id/ai_image_edit_text_placeholder"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                layout="@layout/media_gen_editor_text_input"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.libraries.youtube.creation.editor.image.mediagen.MediaGenInputView
            android:id="@+id/ai_image_editor_text_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
