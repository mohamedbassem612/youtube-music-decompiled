<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/ytAssistiveFeedVibrantGradient1"
                android:endColor="?attr/ytAssistiveFeedVibrantGradient3"
                android:angle="0"
                android:centerColor="?attr/ytAssistiveFeedVibrantGradient2"/>
            <corners android:radius="@dimen/music_snackbar_corner_radius"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ytm_theme_main_color_primary"/>
            <corners android:radius="@dimen/music_snackbar_corner_radius"/>
        </shape>
    </item>
</layer-list>
