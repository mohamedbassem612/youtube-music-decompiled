<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_now_playing_description"
    android:minWidth="@dimen/app_widget_minimum_width"
    android:minHeight="@dimen/app_widget_two_row_minimum_height"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/app_widget_now_playing_initial"
    android:resizeMode="vertical|horizontal"
    android:minResizeWidth="@dimen/app_widget_resizable_minimum_width"
    android:minResizeHeight="@dimen/app_widget_one_row_minimum_height"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/app_widget_now_playing_preview"
    android:maxResizeWidth="@dimen/app_widget_max_width"
    android:maxResizeHeight="@dimen/app_widget_now_playing_resizable_max_height"
    android:targetCellWidth="4"
    android:targetCellHeight="2"/>
